{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campuslife",
  "account_id": "cc30f763e73992f6f28af6471721a947",
  "compatibility_date": "2026-10-10",
  "main": "worker/index.ts",
  "assets": {
    // Vite build output. Unknown routes (e.g. /feed on refresh) fall back to index.html.
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // 10 TTS requests per IP per minute (namespace_id is any account-unique number).
  "ratelimits": [
    { "name": "TTS_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "workers_dev": true,
  "preview_urls": true
}
