{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campuslife",
  "account_id": "cc30f763e73992f6f28af6471721a947",
  "compatibility_date": "2026-10-10",
  "main": "worker/index.ts",
  "assets": {
    // Vite build output. Unknown routes (e.g. /feed on refresh) fall back to index.html.
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "preview_urls": true
}
